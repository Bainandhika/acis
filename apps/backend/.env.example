# Server & Environment
PORT=8080
GIN_MODE=release # debug | release
LOG_LEVEL=info # debug | info | warn | error

# Database (Option A: Full URL e.g. Neon, Supabase, Render PostgreSQL)
DATABASE_URL=postgres://acis_user:acis_secret_password@localhost:5432/acis_db?sslmode=disable

# Database (Option B: Discrete Parameters)
DB_HOST=localhost
DB_PORT=5432
DB_USER=acis_user
DB_PASSWORD=acis_secret_password
DB_NAME=acis_db
DB_SSLMODE=disable

# Redis (Option A: Full URL e.g. Upstash, Redis Cloud)
REDIS_URL=redis://localhost:6379/0

# Redis (Option B: Discrete Parameters)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security & Secrets (Generate strong 32+ character random secrets)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRY=15m
OTP_ENCRYPTION_KEY=your_32_bytes_aes_gcm_secret_key!
OTP_TTL=5m

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_WEBHOOK_SECRET=your_random_telegram_webhook_secret_token

# Email Delivery (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=onboarding@resend.dev

# CORS Settings (Comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-acis-app.vercel.app
