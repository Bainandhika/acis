# Server & Environment
PORT=8080
GIN_MODE=release # debug | release
LOG_LEVEL=info # debug | info | warn | error

# Database (Option A: Dual Pools for Supabase RLS)
DATABASE_APP_DSN=postgresql://acis_app:acis_app_password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_ADMIN_DSN=postgresql://postgres.gkouiqfystipswyqwdu:service_role_or_db_password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require

# Database (Option B: Single Full URL / Discrete Parameters fallback)
DATABASE_URL=postgres://acis_user:acis_secret_password@localhost:5432/acis_db?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=acis_user
DB_PASSWORD=acis_secret_password
DB_NAME=acis_db
DB_SSLMODE=disable

# Supabase Auth
SUPABASE_JWKS_URL=https://gkouiqfystipswyqwdu.supabase.co/auth/v1/.well-known/jwks.json

# Redis (Option A: Full URL e.g. Upstash, Redis Cloud)
REDIS_URL=redis://localhost:6379/0

# Redis (Option B: Discrete Parameters)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Telegram Bot Integration (Bot token stored ONLY in environment variables)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_WEBHOOK_SECRET=your_random_telegram_webhook_secret_token
TELEGRAM_BOT_USERNAME=your_acis_bot_username

# Internal Bot Secret (Shared between backend and bot service)
BOT_INTERNAL_SECRET=changeme_internal_bot_secret_key

# CORS Settings (Comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-acis-app.vercel.app
