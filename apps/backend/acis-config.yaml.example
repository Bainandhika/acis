server:
  port: "8080"
  mode: "debug" # debuu | release

database:
  host: "localhost"
  port: "5432"
  user: "${DB_USER}"
  password: "${DB_PASSWORD}"
  name: "${DB_NAME}"
  ssl_mode: "disable"
  time_zone: "Asia/Jakarta"

jwt:
  secret: "${JWT_SECRET}"
  expiry: "15m"

log:
  dir: "./logs"
  level: "debug" # debug | info | error | warn

redis:
  host: "localhost"
  port: "6379"
  password: "${REDIS_PASSWORD}"
  db: "${REDIS_DB}"

otp:
  ttl: 300 # in seconds
  encryption_key: "${OTP_ENCRYPTION_KEY}"

